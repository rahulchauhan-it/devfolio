# Copy to .env and fill in. NEVER commit the real .env file.

# Database
POSTGRES_DB=devfolio
POSTGRES_USER=devfolio
POSTGRES_PASSWORD=change_me_locally

# Backend (used from Week 2 onward)
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5433/devfolio
DB_USERNAME=devfolio
DB_PASSWORD=change_me_locally
JWT_SECRET=generate_a_long_random_string_of_at_least_32_chars
# Frontend origin allowed to call the API (CORS).
# Exact origin only: scheme + host + port, no trailing slash.
# Production: your deployed frontend URL (e.g. https://your-app.vercel.app)
CORS_ALLOWED_ORIGIN=http://localhost:5173
GITHUB_TOKEN=
